{
  "name": "dsh-blackboard",
  "version": "0.0.1",
  "description": "Human/agent shared drawing board for DeepSeek Harness: a right-sidebar board plus the blackboard_draw tool",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "blackboard",
    "drawing"
  ],
  "exports": {
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "blackboard.cordis.yml",
    "core",
    "shared",
    "host",
    "client",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --import tsx/esm --test --test-isolation=none \"tests/*.spec.ts\"",
    "build": "node build/build-client.mjs",
    "probe": "node --import tsx/esm probe-host-import.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run probe"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "perfect-freehand": "1.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "tsx": "4.22.4",
    "typescript": "^6.0.3"
  }
}
